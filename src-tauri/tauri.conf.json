{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocity Mini",
  "version": "0.1.0",
  "identifier": "ai.velocity.mini",
  "build": {
    "beforeDevCommand": "npm run dev:client -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420/mini.html",
    "beforeBuildCommand": "npm run build:mini",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velocity Mini",
        "url": "mini.html",
        "width": 76,
        "height": 76,
        "minWidth": 76,
        "minHeight": 76,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:3001"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Floating code review companion"
  }
}
